# ==========================================
# TurfHub Root .gitignore
# ==========================================

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.sublime-project
*.sublime-workspace

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# Logs & Classes
*.log
*.class

# ------------------------------------------
# Backend (Spring Boot & Maven)
# ------------------------------------------
backend/target/
backend/.apt_generated/
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache
backend/bin/

# ------------------------------------------
# Mobile (Flutter & Dart)
# ------------------------------------------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_assets/
mobile/ios/ServiceDefinitions.json
mobile/macos/Pods/
mobile/macos/Flutter/ephemeral/
mobile/windows/flutter/ephemeral/
mobile/linux/flutter/ephemeral/
